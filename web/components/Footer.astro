---
import logo from "../../assets/images/logo.svg";
---

<footer class="footer section-tight">
  <div class="footer-grid">
    <div class="footer-brand-col">
      <div class="nav-brand">
        <img src={logo.src} alt="OpenEyes" />
        OpenEyes
      </div>
      <p class="footer-desc">
        Hardware-agnostic edge robot vision framework. YOLO, MediaPipe, TensorRT at 60 FPS.
      </p>
      <div class="footer-status">
        <span class="status-dot"></span>
        <span class="text-mono">All systems normal</span>
      </div>
    </div>

    <div class="footer-links-col">
      <h4 class="footer-heading">Product</h4>
      <a href="/" class="footer-link">Overview</a>
      <a href="/hardware" class="footer-link">Hardware</a>
      <a href="/demos" class="footer-link">Demos</a>
    </div>

    <div class="footer-links-col">
      <h4 class="footer-heading">Resources</h4>
      <a href="/docs" class="footer-link">Documentation</a>
      <a href="https://github.com/mandarwagh9/openeyes/blob/main/CHANGELOG.md" target="_blank" rel="noreferrer" class="footer-link">Changelog</a>
      <a href="/community" class="footer-link">Community</a>
      <a href="https://github.com/mandarwagh9/openeyes" target="_blank" rel="noreferrer" class="footer-link">GitHub</a>
    </div>

    <div class="footer-links-col">
      <h4 class="footer-heading">Legal</h4>
      <a href="https://github.com/mandarwagh9/openeyes/blob/main/LICENSE.md" target="_blank" rel="noreferrer" class="footer-link">License</a>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-meta">&copy; 2026 OpenEyes Project</div>
    <div class="footer-meta text-mono text-accent">v3.0.1</div>
  </div>
</footer>
